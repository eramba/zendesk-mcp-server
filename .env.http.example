PUBLIC_BASE_URL=https://<your-mcp-host>
ZENDESK_SUBDOMAIN=<your-zendesk-subdomain>
ZENDESK_OAUTH_CLIENT_ID=<your-zendesk-oauth-client-id>
ZENDESK_OAUTH_CLIENT_SECRET=<your-zendesk-oauth-client-secret>
# Generate OAUTH_ENCRYPTION_KEY separately as a base64-encoded 32-byte key.
OAUTH_ENCRYPTION_KEY=<separately-generated-base64-32-byte-key>
OAUTH_DB_PATH=/data/oauth.sqlite
MCP_ALLOWED_HOSTS=<your-mcp-host>,localhost,127.0.0.1
HOST=0.0.0.0
PORT=3000
MCP_ACCESS_TOKEN_TTL_SECONDS=900
ZENDESK_HTTP_TIMEOUT_MS=15000
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST_PORT=38184
